# Copy to `.env` for local overrides (optional in Vite).
#
# Dev: leave VITE_API_BASE_URL unset — Vite proxies /api -> call_api (default :8090).
# Prod / separate host: set the absolute URL of call_api (no trailing slash).
#
# VITE_API_BASE_URL=http://localhost:8090
# VITE_API_BASE_URL=https://wc-call.13.232.129.80.nip.io
# VITE_API_BASE_URL=https://api.example.com
#
# Render production build must set the same VITE_API_BASE_URL in the service env.
# Auto-deploy: GitHub Actions workflow `.github/workflows/deploy-render.yml`
# needs secret RENDER_DEPLOY_HOOK_URL (Render → Settings → Deploy Hook),
# or enable Auto-Deploy "After CI Checks Pass" / "On Commit" in Render.
#
# Local microphone RMS floor (0..1). Raise slightly in noisy rooms.
# VITE_MIC_RMS_THRESHOLD=0.006

# Vite client port (default 5173)
# CLIENT_PORT=5173

# call_api port used by the Vite /api proxy in vite.config.ts (default 8090)
# API_PORT=8090
